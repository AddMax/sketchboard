<?xml version="1.0" encoding="utf-8"?>
<!--
    Маппинг живёт здесь, а не в атрибутах агрегата: доменный класс не должен
    зависеть от Doctrine. Схема таблицы при этом та же, что и раньше.
-->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Note\Note" table="notes">
        <indexes>
            <index name="idx_notes_created_at" columns="created_at"/>
        </indexes>

        <id name="id" type="note_id" column="id"/>

        <field name="text" type="note_text" column="text"/>
        <field name="color" type="note_color" column="color" length="16"/>
        <field name="author" type="note_author" column="author" length="64"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>

        <embedded name="position"
                  class="App\Domain\Note\ValueObject\Position"
                  use-column-prefix="false"/>
    </entity>

</doctrine-mapping>
