{
    "name": "sketchboard/backend",
    "description": "Sketchboard API — Symfony 8.1 на PHP 8.5",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "amphp/http-server-router": "^2",
        "amphp/redis": "^2.0",
        "amphp/socket": "^2.4",
        "amphp/websocket-server": "^4.0",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/monolog-bundle": "^4.0",
        "symfony/runtime": "^8.1",
        "symfony/uid": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "symfony/debug-bundle": "^8.1",
        "symfony/maker-bundle": "^1.62",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/var-dumper": "^8.1"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
