# ── Проброс портов на хост ────────────────────────────────────────────────
HTTP_PORT=8080          # nginx — единая точка входа (фронт + API + WS)
POSTGRES_PORT=5432      # прямой доступ к БД с хоста (для GUI-клиентов)
REDIS_PORT=6379

# ── UID/GID владельца файлов в контейнерах (совпадение с хостом) ──────────
UID=1000
GID=1000

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=sketchboard
POSTGRES_USER=sketchboard
POSTGRES_PASSWORD=sketchboard

# ── Symfony ───────────────────────────────────────────────────────────────
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_in_production_0123456789abcdef

# Xdebug в контейнере php: off — выключен, debug — пошаговая отладка,
# debug,develop — плюс подробный var_dump. Переключать: make xdebug-on / xdebug-off
XDEBUG_MODE=off


# ── Сеть Docker ───────────────────────────────────────────────────────────
# MTU внутренней сети. 1500 (значение по умолчанию у Docker) не проходит,
# если трафик машины идёт через VPN: смотрите `ip link show` у своего
# VPN-интерфейса и ставьте не больше него.
DOCKER_MTU=1420

# Адрес, по которому приложение открывают в браузере: Centrifugo сверяет
# с ним заголовок Origin при подключении
APP_ORIGIN=http://localhost:8080

# ── Centrifugo ────────────────────────────────────────────────────────────
# Канал доски: <namespace>:<идентификатор>
REALTIME_CHANNEL=board:main
# Ключ HTTP API — им бэкенд публикует события
CENTRIFUGO_API_KEY=замените_на_случайный_ключ
# Секрет подписи JWT подключения — им бэкенд выдаёт токены браузерам
CENTRIFUGO_TOKEN_SECRET=замените_на_случайный_секрет
# Срок жизни токена подключения, секунд
CENTRIFUGO_TOKEN_TTL=3600

# ── Garage: хранилище файлов ──────────────────────────────────────────────
# Секрет внутреннего RPC (64 hex-символа) и токен admin API — генерирует make init
GARAGE_RPC_SECRET=замените_на_случайный_секрет
GARAGE_ADMIN_TOKEN=замените_на_случайный_токен
# Пара ключей S3: ID вида GK + 24 hex-символа, секрет — 64 hex-символа.
# Garage импортирует её при старте, бэкенд ходит с ней в S3 API
S3_ACCESS_KEY=замените_на_ключ
S3_SECRET_KEY=замените_на_секрет
# Бакеты: public раздаётся без подписи через /files/, private — только через API
S3_BUCKET_PUBLIC=public
S3_BUCKET_PRIVATE=private
# Ёмкость, которую узел объявляет кластеру (на одном узле — просто лимит)
GARAGE_CAPACITY=10G
