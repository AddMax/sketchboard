# ── Проброс портов на хост ────────────────────────────────────────────────
HTTP_PORT=8080          # nginx — единая точка входа (фронт + API + WS)
POSTGRES_PORT=5432      # прямой доступ к БД с хоста (для GUI-клиентов)
REDIS_PORT=6379

# ── UID/GID владельца файлов в контейнерах (совпадение с хостом) ──────────
UID=1000
GID=1000

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=sketchboard
POSTGRES_USER=sketchboard
POSTGRES_PASSWORD=sketchboard

# ── Symfony ───────────────────────────────────────────────────────────────
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_in_production_0123456789abcdef

# ── Realtime ──────────────────────────────────────────────────────────────
# Канал Redis Pub/Sub, через который бэкенд шлёт события в WS-сервер
REALTIME_CHANNEL=sketchboard.events
WEBSOCKET_PORT=8081

# ── Сеть Docker ───────────────────────────────────────────────────────────
# MTU внутренней сети. 1500 (значение по умолчанию у Docker) не проходит,
# если трафик машины идёт через VPN: смотрите `ip link show` у своего
# VPN-интерфейса и ставьте не больше него.
DOCKER_MTU=1420
